# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
tests/
.debug
context.md
AGENTS.md
# Build-time inputs only. bundle-values-schema.py folds these into
# values.schema.json, so the packaged chart already carries their content and
# shipping them again would just invite drift between the two.
schemas/
