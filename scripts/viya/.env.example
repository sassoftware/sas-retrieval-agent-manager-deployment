# Copy this file to a private env file. Enter valid values before use.
# Use NAME=value lines. Do not add export or shell quotes.
# Keep the private env file out of version control.

VIYA_URL=https://viya.example.com
VIYA_USER=viya_admin
VIYA_PASSWORD=replace-with-viya_admin-password
VIYA_CLIENT_ID=ram-client
VIYA_CLIENT_SECRET=replace-with-output-from-openssl-rand
MCP_CLIENT_ID=ram-app
MCP_CLIENT_SECRET=replace-with-output-from-openssl-rand

RAM_URL=https://ram.example.com
RAM_KC_USER=kcAdmin
RAM_KC_PASSWORD=replace-with-keycloak-admin-password

MCP_IMAGE=ghcr.io/sassoftware/sas-mcp-server:latest

# Set one shared context, or set both contexts for separate clusters.
KUBE_CONTEXT=replace-with-context
# Comment out KUBE_CONTEXT before setting separate contexts.
# RAM_KUBE_CONTEXT=replace-with-ram-context
# VIYA_KUBE_CONTEXT=replace-with-viya-context

# These values are optional. The scripts use these defaults.
SKIP_HOME_DIRECTORIES=true
# Set true to skip the applicable step. These steps run by default.
SKIP_MCP_SERVERS=false
SKIP_RAM_APP_REGISTRATION=false
SKIP_VIYA_GROUP_MEMBERS=false
RAM_NAMESPACE=retagentmgr
VIYA_NAMESPACE=viya
RAM_RELEASE=retrieval-agent-manager
IDP_ALIAS=viya-oidc

# Set the display names and descriptions of the RAM groups in Viya.
# Keep the group IDs unchanged.
RAM_ADMIN_GROUP_NAME=RAM Admin
RAM_ADMIN_GROUP_DESC=Users with admin access to Retrieval Agent Manager
RAM_USER_GROUP_NAME=RAM User
RAM_USER_GROUP_DESC=Users with user access to Retrieval Agent Manager

# Set these only when they match the existing RAM Secrets.
# RAM_KC_REALM=sas-iot
# RAM_KC_CLIENT_ID=sas-ram-app

# These values are optional for the standalone identity script.
# RAM_KC_ADMIN_GROUP=Admin
# RAM_KC_USER_GROUP=User

# Set true only when the RAM TLS certificate is trusted.
# SSL_VERIFY=true
