# Copy this file to a private env file. Enter valid values before use.
# Use NAME=value lines. Do not add export or shell quotes.
# Keep the private env file out of version control.

VIYA_URL=https://viya.example.com
VIYA_USER=sasboot
VIYA_PASSWORD=replace-with-sasboot-password
VIYA_CLIENT_ID=ram-client
VIYA_CLIENT_SECRET=replace-with-a-unique-client-secret

RAM_URL=https://ram.example.com
RAM_KC_USER=kcAdmin
RAM_KC_PASSWORD=replace-with-keycloak-admin-password

MCP_IMAGE=registry.example.com/sas-mcp-tools:latest

# These values are optional. The scripts use these defaults.
RAM_NAMESPACE=retagentmgr
VIYA_NAMESPACE=viya
RAM_RELEASE=retrieval-agent-manager
IDP_ALIAS=viya-oidc

# Set KUBE_CONTEXT for one shared cluster.
# KUBE_CONTEXT=replace-with-context
# Set both values when RAM and Viya use separate clusters.
# RAM_KUBE_CONTEXT=replace-with-ram-context
# VIYA_KUBE_CONTEXT=replace-with-viya-context

# Set these only when they match the existing RAM Secrets.
# RAM_KC_REALM=sas-iot
# RAM_KC_CLIENT_ID=sas-ram-app

# These values are optional for the standalone identity script.
# RAM_KC_ADMIN_GROUP=Admin
# RAM_KC_USER_GROUP=User

# Set true only when the RAM TLS certificate is trusted.
# SSL_VERIFY=true
