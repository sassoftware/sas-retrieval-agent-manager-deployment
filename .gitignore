# Jekyll build output and caches
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/
vendor/bundle/

# Logs and backups
*.log
*.bak

# Temporary and editor files
*.tmp
*.temp
*~
.#*
*.swp
*.swo
.DS_Store
Thumbs.db

# GPG key material generated by scripts/gpg/run-bootstrap-gpg.{ps1,sh}
# NEVER commit these. The private key and passphrase cannot be rotated for an
# installed system: losing or leaking them is unrecoverable.
scripts/gpg/output/
*-private.key
*-passphrase.txt